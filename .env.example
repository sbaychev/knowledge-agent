# Optional chat-model provider. Set this for the profile/provider you use.
OPENAI_API_KEY=

# These values match docker-compose.yml and application-local.yml.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/knowledge_agent
SPRING_DATASOURCE_USERNAME=knowledge
SPRING_DATASOURCE_PASSWORD=knowledge

# Local Anthropic-compatible proxy (only when using the local,anthropic profiles).
LLM_BASE_URL=http://localhost:6655/anthropic
LLM_API_KEY=local-llm-proxy
LLM_MODEL=claude-sonnet-latest
LLM_TIMEOUT=30s
LLM_MAX_TOKENS=2048

# Optional RAG embeddings (used only with the rag profile).
EMBEDDING_BASE_URL=http://localhost:6655/openai/v1
EMBEDDING_API_KEY=local-embedding-proxy
EMBEDDING_MODEL=text-embedding-3-small

# Optional MCP Streamable HTTP smoke-test target.
MCP_BASE_URL=http://localhost:8080/mcp
